From e2d84394efedf778122c6b95b57430913eb6a803 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 10:31:29 +0000
Subject: [PATCH] Remove pet photos when the integration is removed; bump to
 1.1.0

async_remove_entry deleted only the storage file, leaving photos behind in
<config>/ha_pet_care_photos/. Remove this entry's photos (files prefixed
with the entry id) in the executor, and the folder if it ends up empty.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EvLRrknw6Xtj3xb3Yac7f6
---
 custom_components/ha_pet_care/__init__.py   |  2 +-
 custom_components/ha_pet_care/manifest.json |  2 +-
 custom_components/ha_pet_care/store.py      | 22 ++++++++++++++++++++-
 3 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/custom_components/ha_pet_care/__init__.py b/custom_components/ha_pet_care/__init__.py
index 7f01b17..335bc7f 100644
--- a/custom_components/ha_pet_care/__init__.py
+++ b/custom_components/ha_pet_care/__init__.py
@@ -176,5 +176,5 @@ async def async_unload_entry(hass: HomeAssistant, entry: PetCareConfigEntry) ->
 
 
 async def async_remove_entry(hass: HomeAssistant, entry: PetCareConfigEntry) -> None:
-    """Delete stored data when the integration is removed."""
+    """Delete stored data and photos when the integration is removed."""
     await PetCareStore(hass, entry.entry_id).async_remove_storage()
diff --git a/custom_components/ha_pet_care/manifest.json b/custom_components/ha_pet_care/manifest.json
index 2c05f89..3a71950 100644
--- a/custom_components/ha_pet_care/manifest.json
+++ b/custom_components/ha_pet_care/manifest.json
@@ -10,5 +10,5 @@
   "issue_tracker": "https://github.com/jacardbr/ha-pet-care/issues",
   "requirements": [],
   "single_config_entry": true,
-  "version": "1.0.0"
+  "version": "1.1.0"
 }
diff --git a/custom_components/ha_pet_care/store.py b/custom_components/ha_pet_care/store.py
index fd95ebe..778f02d 100644
--- a/custom_components/ha_pet_care/store.py
+++ b/custom_components/ha_pet_care/store.py
@@ -95,6 +95,21 @@ def _remove_file(path: str) -> None:
         pass
 
 
+def _remove_entry_photos(photo_dir: str, prefix: str) -> None:
+    """Remove an entry's photos and the folder if empty (runs in the executor)."""
+    try:
+        names = os.listdir(photo_dir)
+    except OSError:
+        return
+    for name in names:
+        if name.startswith(prefix):
+            _remove_file(os.path.join(photo_dir, name))
+    try:
+        os.rmdir(photo_dir)
+    except OSError:
+        pass
+
+
 class PetCareStore:
     """Keeps pets and their records, persisted in .storage."""
 
@@ -115,8 +130,13 @@ class PetCareStore:
             self._data = data
 
     async def async_remove_storage(self) -> None:
-        """Delete the storage file."""
+        """Delete the storage file and this entry's photos."""
         await self._store.async_remove()
+        await self.hass.async_add_executor_job(
+            _remove_entry_photos,
+            self.hass.config.path(PHOTO_DIR),
+            f"{self.entry_id}_",
+        )
 
     async def _async_save(self) -> None:
         await self._store.async_save(self._data)
-- 
